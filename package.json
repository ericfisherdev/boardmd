{
	"name": "obsidiboard",
	"version": "0.1.0",
	"description": "Lightweight Jira-style backlog, sprints and boards for Obsidian, stored as notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"lint": "eslint .",
		"check:manifest": "jiti scripts/checkManifest.ts"
	},
	"keywords": ["obsidian", "kanban", "scrum", "sprint", "backlog"],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7"
	}
}
